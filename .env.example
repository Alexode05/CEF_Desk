# ---------------------------------------------------------------------------
# CEF Desk — variables d'environnement
# Copier ce fichier en `.env` et adapter les valeurs. Le fichier `.env` ne doit
# JAMAIS être committé (il est dans .gitignore).
# ---------------------------------------------------------------------------

# Clé secrète Django (obligatoire). Générer avec :
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=remplacer-par-une-vraie-cle-secrete

# Mode debug : True en développement local uniquement, False en production.
DJANGO_DEBUG=True

# Hôtes autorisés (séparés par des virgules).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de données. Vide => SQLite locale (db.sqlite3). En production :
#   DATABASE_URL=postgres://utilisateur:motdepasse@hote:5432/cefdesk
DATABASE_URL=

# Code d'invitation requis pour créer un compte comité depuis la page de connexion.
# Vide => création de compte désactivée. À communiquer uniquement aux membres du comité.
CEF_REGISTRATION_CODE=

# Email sortant. Vide => les emails sont affichés dans la console (développement).
#   EMAIL_URL=smtp+tls://utilisateur:motdepasse@mail.infomaniak.com:587
EMAIL_URL=
DEFAULT_FROM_EMAIL=CEF Desk <noreply@localhost>

# Forcer HTTPS (redirection + cookies sécurisés). Mettre True en production.
DJANGO_FORCE_HTTPS=False
